@@ -0,0 +1,45 @@
+# Automakaza AUDIN (ESP_S3-AUDIN RE1.1)
+
+Placa adaptadora de áudio para módulo ESP32-S3-WROOM-1 **N16R8** (16 MB de flash,
+8 MB de PSRAM octal), com codec **ES8388**, amplificador **HT6872**, dois
+microfones de eletreto, três botões e conector para display.
+
+## Pinagem
+
+| Função | GPIO |
+|---|---|
+| I2C do ES8388 (SDA / SCL), endereço 0x10 | 14 / 47 |
+| I2S MCLK / BCLK / LRCK | 8 / 3 / 9 |
+| I2S saída para o codec (DSDIN) | 46 |
+| I2S entrada do microfone (ASDOUT, entrada LINE1) | 10 |
+| Botão BOOT do módulo | 0 |
+| Botões esquerdo / meio / direito | 12 / 11 / 13 |
+| LED verde | 21 |
+| Display OLED I2C (SDA / SCL), endereço 0x3C | 5 / 4 |
+
+Observações:
+
+- O HT6872 não tem enable em GPIO: fica sempre ligado. Para não haver chiado,
+  as saídas analógicas do DAC são desligadas quando o áudio fica ocioso.
+- **Alimente pela USB-C da placa principal.** Pela USB do módulo o ES8388 fica
+  sem alimentação (todas as linhas dele ficam presas em nível baixo).
+- O display é opcional: sem resposta em 0x3C, a placa segue sem tela.
+
+## Botões
+
+- **BOOT ou meio**: inicia/encerra a conversa. Durante a partida, entra na
+  configuração de Wi-Fi.
+- **Direita**: volume +10 (segurar = máximo).
+- **Esquerda**: volume -10 (segurar = mudo).
+
+## Compilar
+
+Variantes por tipo de display:
+
+- `automakaza-audin-128x64` (SSD1306 128x64)
+- `automakaza-audin-128x32` (SSD1306 128x32)
+- `automakaza-audin-sh1106` (SH1106 128x64)
+
+```bash
+python scripts/build.py automakaza-audin --name automakaza-audin-128x64 --language pt-BR
+```
diff --git a/main/boards/automakaza-audin/automakaza_audin_board.cc b/main/boards/automakaza-audin/automakaza_audin_board.cc
new file mode 100644
index 0000000..e244e91
--- /dev/null
+++ b/main/boards/automakaza-audin/automakaza_audin_board.cc
@@ -0,0 +1,248 @@
+// ============================================================================
+// Automakaza AUDIN - placa ESP_S3-AUDIN RE1.1 (ESP32-S3 N16R8 + ES8388)
+//
+// - Áudio: Es8388AudioCodec (I2S duplex), com as saídas analógicas do DAC
+//   desligadas quando o áudio fica ocioso (o HT6872 não tem enable).
+// - Display: OLED I2C SSD1306/SH1106 opcional (SDA GPIO5, SCL GPIO4). Se não
+//   houver display ligado, a placa funciona sem ele.
+// - Botões: BOOT (módulo) e meio = conversar / configurar Wi-Fi;
+//   esquerda = volume -, direita = volume +.
+// - LED: verde da placa principal (GPIO21).
+// ============================================================================
+
+#include "wifi_board.h"
+#include "codecs/es8388_audio_codec.h"
+#include "display/oled_display.h"
+#include "application.h"
+#include "button.h"
+#include "config.h"
+#include "led/gpio_led.h"
+#include "assets/lang_config.h"
+
+#include <esp_log.h>
+#include <driver/i2c_master.h>
+#include <esp_lcd_panel_ops.h>
+#include <esp_lcd_panel_vendor.h>
+
+#ifdef SH1106
+#include <esp_lcd_panel_sh1106.h>
+#endif
+
+#define TAG "AutomakazaAudin"
+
+// ES8388 com desligamento das saídas analógicas do DAC em repouso.
+// No Es8388AudioCodec original, EnableOutput(false) só aplica mudo digital; o
+// DAC continua ligado e, como o amplificador desta placa fica sempre ligado,
+// sobra um chiado. Aqui o registrador 0x04 (DACPOWER) vai a 0xC0 em repouso e
+// volta a 0x3C antes de tocar.
+class AudinAudioCodec : public Es8388AudioCodec {
+public:
+    AudinAudioCodec(i2c_master_bus_handle_t i2c_bus, int input_sample_rate, int output_sample_rate)
+        : Es8388AudioCodec((void*)i2c_bus, I2C_NUM_0, input_sample_rate, output_sample_rate,
+                           AUDIO_I2S_GPIO_MCLK, AUDIO_I2S_GPIO_BCLK, AUDIO_I2S_GPIO_WS,
+                           AUDIO_I2S_GPIO_DOUT, AUDIO_I2S_GPIO_DIN, AUDIO_CODEC_PA_PIN,
+                           AUDIO_CODEC_ES8388_ADDR, AUDIO_INPUT_REFERENCE) {
+#if AUDIO_DAC_POWER_DOWN_ON_IDLE
+        i2c_device_config_t dev_cfg = {};
+        dev_cfg.dev_addr_length = I2C_ADDR_BIT_LEN_7;
+        dev_cfg.device_address = AUDIO_CODEC_ES8388_ADDR_7BIT;
+        dev_cfg.scl_speed_hz = 100 * 1000;
+        if (i2c_master_bus_add_device(i2c_bus, &dev_cfg, &dac_dev_) != ESP_OK) {
+            ESP_LOGW(TAG, "Sem acesso direto ao ES8388; DAC fica sempre ligado");
+            dac_dev_ = nullptr;
+        }
+#endif
+    }
+
+    virtual void EnableOutput(bool enable) override {
+        if (enable) {
+            SetDacPower(true);
+            Es8388AudioCodec::EnableOutput(true);
+        } else {
+            Es8388AudioCodec::EnableOutput(false);
+            SetDacPower(false);
+        }
+    }
+
+private:
+    i2c_master_dev_handle_t dac_dev_ = nullptr;
+
+    void SetDacPower(bool on) {
+#if AUDIO_DAC_POWER_DOWN_ON_IDLE
+        if (dac_dev_ == nullptr) {
+            return;
+        }
+        uint8_t buf[2] = {0x04, static_cast<uint8_t>(on ? 0x3C : 0xC0)};
+        esp_err_t err = i2c_master_transmit(dac_dev_, buf, sizeof(buf), 100);
+        if (err != ESP_OK) {
+            ESP_LOGW(TAG, "Falha ao escrever DACPOWER: %s", esp_err_to_name(err));
+        }
+#else
+        (void)on;
+#endif
+    }
+};
+
+class AutomakazaAudinBoard : public WifiBoard {
+private:
+    i2c_master_bus_handle_t codec_i2c_bus_ = nullptr;
+    i2c_master_bus_handle_t display_i2c_bus_ = nullptr;
+    esp_lcd_panel_io_handle_t panel_io_ = nullptr;
+    esp_lcd_panel_handle_t panel_ = nullptr;
+    Display* display_ = nullptr;
+    Button boot_button_;
+    Button talk_button_;
+    Button volume_up_button_;
+    Button volume_down_button_;
+
+    void InitializeCodecI2c() {
+        i2c_master_bus_config_t bus_config = {
+            .i2c_port = I2C_NUM_0,
+            .sda_io_num = AUDIO_CODEC_I2C_SDA_PIN,
+            .scl_io_num = AUDIO_CODEC_I2C_SCL_PIN,
+            .clk_source = I2C_CLK_SRC_DEFAULT,
+            .glitch_ignore_cnt = 7,
+            .intr_priority = 0,
+            .trans_queue_depth = 0,
+            .flags = {
+                .enable_internal_pullup = 1,
+            },
+        };
+        ESP_ERROR_CHECK(i2c_new_master_bus(&bus_config, &codec_i2c_bus_));
+    }
+
+    void InitializeDisplayI2c() {
+        i2c_master_bus_config_t bus_config = {
+            .i2c_port = I2C_NUM_1,
+            .sda_io_num = DISPLAY_SDA_PIN,
+            .scl_io_num = DISPLAY_SCL_PIN,
+            .clk_source = I2C_CLK_SRC_DEFAULT,
+            .glitch_ignore_cnt = 7,
+            .intr_priority = 0,
+            .trans_queue_depth = 0,
+            .flags = {
+                .enable_internal_pullup = 1,
+            },
+        };
+        ESP_ERROR_CHECK(i2c_new_master_bus(&bus_config, &display_i2c_bus_));
+    }
+
+    void InitializeOledDisplay() {
+        // Display é opcional: sem resposta em 0x3C, segue sem tela.
+        if (i2c_master_probe(display_i2c_bus_, DISPLAY_I2C_ADDR, 100) != ESP_OK) {
+            ESP_LOGW(TAG, "OLED não encontrado em 0x%02X; seguindo sem display", DISPLAY_I2C_ADDR);
+            display_ = new NoDisplay();
+            return;
+        }
+
+        esp_lcd_panel_io_i2c_config_t io_config = {
+            .dev_addr = DISPLAY_I2C_ADDR,
+            .scl_speed_hz = 400 * 1000,
+            .control_phase_bytes = 1,
+            .dc_bit_offset = 6,
+            .lcd_cmd_bits = 8,
+            .lcd_param_bits = 8,
+            .on_color_trans_done = nullptr,
+            .user_ctx = nullptr,
+            .flags = {
+                .dc_low_on_data = 0,
+                .disable_control_phase = 0,
+            },
+        };
+        ESP_ERROR_CHECK(esp_lcd_new_panel_io_i2c(display_i2c_bus_, &io_config, &panel_io_));
+
+        esp_lcd_panel_dev_config_t panel_config = {};
+        panel_config.reset_gpio_num = GPIO_NUM_NC;
+        panel_config.bits_per_pixel = 1;
+
+        esp_lcd_panel_ssd1306_config_t ssd1306_config = {
+            .height = static_cast<uint8_t>(DISPLAY_HEIGHT),
+        };
+        panel_config.vendor_config = &ssd1306_config;
+
+#ifdef SH1106
+        ESP_ERROR_CHECK(esp_lcd_new_panel_sh1106(panel_io_, &panel_config, &panel_));
+#else
+        ESP_ERROR_CHECK(esp_lcd_new_panel_ssd1306(panel_io_, &panel_config, &panel_));
+#endif
+
+        ESP_ERROR_CHECK(esp_lcd_panel_reset(panel_));
+        if (esp_lcd_panel_init(panel_) != ESP_OK) {
+            ESP_LOGE(TAG, "Falha ao iniciar o OLED; seguindo sem display");
+            display_ = new NoDisplay();
+            return;
+        }
+        ESP_ERROR_CHECK(esp_lcd_panel_invert_color(panel_, false));
+        ESP_ERROR_CHECK(esp_lcd_panel_disp_on_off(panel_, true));
+
+        display_ = new OledDisplay(panel_io_, panel_, DISPLAY_WIDTH, DISPLAY_HEIGHT,
+                                   DISPLAY_MIRROR_X, DISPLAY_MIRROR_Y);
+    }
+
+    void ToggleChatOrConfigureWifi() {
+        auto& app = Application::GetInstance();
+        if (app.GetDeviceState() == kDeviceStateStarting) {
+            EnterWifiConfigMode();
+            return;
+        }
+        app.ToggleChatState();
+    }
+
+    void ChangeVolume(int delta) {
+        auto codec = GetAudioCodec();
+        int volume = codec->output_volume() + delta;
+        if (volume > 100) {
+            volume = 100;
+        }
+        if (volume < 0) {
+            volume = 0;
+        }
+        codec->SetOutputVolume(volume);
+        GetDisplay()->ShowNotification(Lang::Strings::VOLUME + std::to_string(volume));
+    }
+
+    void InitializeButtons() {
+        boot_button_.OnClick([this]() { ToggleChatOrConfigureWifi(); });
+        talk_button_.OnClick([this]() { ToggleChatOrConfigureWifi(); });
+
+        volume_up_button_.OnClick([this]() { ChangeVolume(10); });
+        volume_up_button_.OnLongPress([this]() {
+            GetAudioCodec()->SetOutputVolume(100);
+            GetDisplay()->ShowNotification(Lang::Strings::MAX_VOLUME);
+        });
+
+        volume_down_button_.OnClick([this]() { ChangeVolume(-10); });
+        volume_down_button_.OnLongPress([this]() {
+            GetAudioCodec()->SetOutputVolume(0);
+            GetDisplay()->ShowNotification(Lang::Strings::MUTED);
+        });
+    }
+
+public:
+    AutomakazaAudinBoard() :
+        boot_button_(BOOT_BUTTON_GPIO),
+        talk_button_(TALK_BUTTON_GPIO),
+        volume_up_button_(VOLUME_UP_BUTTON_GPIO),
+        volume_down_button_(VOLUME_DOWN_BUTTON_GPIO) {
+        InitializeCodecI2c();
+        InitializeDisplayI2c();
+        InitializeOledDisplay();
+        InitializeButtons();
+    }
+
+    virtual Led* GetLed() override {
+        static GpioLed led(BUILTIN_LED_GPIO);
+        return &led;
+    }
+
+    virtual AudioCodec* GetAudioCodec() override {
+        static AudinAudioCodec audio_codec(codec_i2c_bus_, AUDIO_INPUT_SAMPLE_RATE, AUDIO_OUTPUT_SAMPLE_RATE);
+        return &audio_codec;
+    }
+
+    virtual Display* GetDisplay() override {
+        return display_;
+    }
+};
+
+DECLARE_BOARD(AutomakazaAudinBoard);
diff --git a/main/boards/automakaza-audin/config.h b/main/boards/automakaza-audin/config.h
new file mode 100644
index 0000000..8119b21
--- /dev/null
+++ b/main/boards/automakaza-audin/config.h
@@ -0,0 +1,70 @@
+#ifndef _BOARD_CONFIG_H_
+#define _BOARD_CONFIG_H_
+
+// ============================================================================
+// Automakaza AUDIN - placa ESP_S3-AUDIN RE1.1
+// Módulo ESP32-S3-WROOM-1 N16R8 (16 MB flash quad / 8 MB PSRAM octal)
+// Codec ES8388 + amplificador HT6872 + 2 microfones de eletreto
+//
+// Pinagem levantada e testada em 03/11/2026 (mapeamento por software +
+// testes de áudio no ESPHome).
+// ============================================================================
+
+#include <driver/gpio.h>
+
+// --- Áudio ------------------------------------------------------------------
+// Es8388AudioCodec exige a mesma taxa na entrada e na saída.
+#define AUDIO_INPUT_SAMPLE_RATE     24000
+#define AUDIO_OUTPUT_SAMPLE_RATE    24000
+#define AUDIO_DEFAULT_OUTPUT_VOLUME 80
+
+// Sem referência de saída na entrada: os dois microfones ocupam LIN1/RIN1 do
+// ES8388 (não há laço de retorno do DAC para cancelamento de eco).
+#define AUDIO_INPUT_REFERENCE       false
+
+#define AUDIO_I2S_GPIO_MCLK GPIO_NUM_8
+#define AUDIO_I2S_GPIO_BCLK GPIO_NUM_3
+#define AUDIO_I2S_GPIO_WS   GPIO_NUM_9
+#define AUDIO_I2S_GPIO_DOUT GPIO_NUM_46   // ESP -> ES8388 (DSDIN)
+#define AUDIO_I2S_GPIO_DIN  GPIO_NUM_10   // ES8388 (ASDOUT) -> ESP
+
+// O HT6872 não tem enable ligado a GPIO (fica sempre ligado).
+#define AUDIO_CODEC_PA_PIN       GPIO_NUM_NC
+#define AUDIO_CODEC_I2C_SDA_PIN  GPIO_NUM_14
+#define AUDIO_CODEC_I2C_SCL_PIN  GPIO_NUM_47
+#define AUDIO_CODEC_ES8388_ADDR  ES8388_CODEC_DEFAULT_ADDR   // 0x20 (8 bits) = 0x10
+#define AUDIO_CODEC_ES8388_ADDR_7BIT 0x10
+
+// Como o amplificador não desliga, em repouso as saídas analógicas do DAC são
+// desligadas (registrador 0x04) para tirar o chiado. Pôr 0 para desativar.
+#define AUDIO_DAC_POWER_DOWN_ON_IDLE 1
+
+// --- Botões e LED -------------------------------------------------------------
+#define BOOT_BUTTON_GPIO         GPIO_NUM_0    // BOOT do módulo
+#define TALK_BUTTON_GPIO         GPIO_NUM_11   // botão do meio
+#define VOLUME_DOWN_BUTTON_GPIO  GPIO_NUM_12   // botão da esquerda
+#define VOLUME_UP_BUTTON_GPIO    GPIO_NUM_13   // botão da direita
+#define BUILTIN_LED_GPIO         GPIO_NUM_21   // LED verde da placa principal
+
+// --- Display OLED I2C (conector lateral) ---------------------------------------
+#define DISPLAY_SDA_PIN GPIO_NUM_5
+#define DISPLAY_SCL_PIN GPIO_NUM_4
+#define DISPLAY_I2C_ADDR 0x3C
+#define DISPLAY_WIDTH   128
+
+#if CONFIG_OLED_SSD1306_128X32
+#define DISPLAY_HEIGHT  32
+#elif CONFIG_OLED_SSD1306_128X64
+#define DISPLAY_HEIGHT  64
+#elif CONFIG_OLED_SH1106_128X64
+#define DISPLAY_HEIGHT  64
+#define SH1106
+#else
+#error "OLED display type is not selected"
+#endif
+
+// Se a imagem aparecer de cabeça para baixo, inverta os dois valores.
+#define DISPLAY_MIRROR_X true
+#define DISPLAY_MIRROR_Y true
+
+#endif // _BOARD_CONFIG_H_
